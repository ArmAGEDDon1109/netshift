{
  "luci-app-netshift": {
    "description": "Grant UCI and RPC access to LuCI app NetShift",
    "read": {
      "file": {
        "/etc/init.d/netshift": [
          "exec"
        ],
        "/usr/bin/netshift": [
          "exec"
        ],
        "/etc/netshift/auto_learned.json": [
          "read"
        ],
        "/opt/zapret/ipset/zapret-hosts-user-exclude.txt": [
          "read"
        ],
        "/opt/zapret/ipset/zapret-hosts-netshift-auto-exclude.txt": [
          "read"
        ]
      },
      "ubus": {
        "service": [
          "list"
        ]
      },
      "uci": [
        "netshift"
      ]
    },
    "write": {
      "uci": [
        "netshift"
      ]
    }
  }
}
